{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "github>codeandsolder/ci-workflows:renovate-ci-trust-root"
  ],
  "dependencyDashboard": true,
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "separateMajorMinor": false,
  "separateMultipleMajor": false,
  "prConcurrentLimit": 3,
  "prHourlyLimit": 3,
  "rebaseWhen": "conflicted",
  "packageRules": [
    {
      "description": "Keep central GitHub Actions tooling current as one reviewed trust-root change",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions tooling",
      "groupSlug": "github-actions-tooling",
      "automerge": false
    },
    {
      "description": "Shared CI trust roots remain independent of generic GitHub Actions grouping and age policy",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "/^codeandsolder\\/(?:ci-workflows|rust-skills2)(?:\\/|$)/"
      ],
      "minimumReleaseAge": null,
      "groupName": "Shared CI trust roots",
      "groupSlug": "shared-ci-trust-roots",
      "automerge": false
    }
  ]
}
